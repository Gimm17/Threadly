APP_NAME=Threadly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: SQLite. Production cPanel: switch to mysql and fill DB_*.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=threadly
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@threadly.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# TokenRouter AI
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_VERIFY_SSL=true
TOKENROUTER_IMAGE_TIMEOUT=180

# AI cost/cache controls for cPanel-safe operation
AI_CACHE_TTL_DAYS=14
AI_DAILY_COST_LIMIT_USD=0
AI_DEFAULT_COST_MODE=hemat
AI_IMAGE_QUEUE_ENABLED=false

# Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI="${APP_URL}/auth/threads/callback"
THREADS_VERIFY_SSL=true

# Threadly runtime config
POST_REMINDER_OFFSET_MINUTES=30
DAILY_INSIGHTS_TIME=07:00

# Seeder defaults. Change before first production seed.
SEED_OWNER_NAME="Gimora Digital"
SEED_OWNER_EMAIL=admin@gimoradigital.id
SEED_OWNER_PASSWORD=password
SEED_WORKSPACE_NAME="Gimora Digital"
SEED_THREADS_HANDLE=gimoradigital.id
